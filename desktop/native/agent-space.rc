1 ICON "../../assets/branding/zixuting/wuyou.ico"

// NSIS uses this string ID to localize the existing Start menu shortcut.
#define IDS_ADAPTER_NAME 101
// 子虚亭适配器. Use Unicode escapes for resource compilers with a local code page.
#define ADAPTER_NAME_ZH L"\x5b50\x865a\x4ead\x9002\x914d\x5668"

STRINGTABLE LANGUAGE 0x09, 0x01
BEGIN
    IDS_ADAPTER_NAME L"Fable Pavilion Adapter"
END

STRINGTABLE LANGUAGE 0x04, 0x02
BEGIN
    IDS_ADAPTER_NAME ADAPTER_NAME_ZH
END

STRINGTABLE LANGUAGE 0x04, 0x01
BEGIN
    IDS_ADAPTER_NAME ADAPTER_NAME_ZH
END
